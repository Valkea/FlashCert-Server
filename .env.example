# Copy to .env next to compose.yaml.

# Base of the links the app hands out (your domain, or domain + path).
FLASHCERT_SHARE_PUBLIC_URL=https://courses.example.com

# Host port the reverse proxy forwards to (bound to 127.0.0.1 only).
# FLASHCERT_SHARE_PORT=8080

# Image to run; leave unset for ghcr.io/valkea/flashcert-share:latest.
# FLASHCERT_SHARE_IMAGE=ghcr.io/valkea/flashcert-share:0.1.0

# Reverse proxies in front (the host's nginx/Caddy/Traefik = 1; 0 if exposed directly).
FLASHCERT_SHARE_PROXIES=1

# SQLite in the "data" volume by default. For PostgreSQL, start with --profile postgres and set:
# POSTGRES_PASSWORD=a-long-random-password
# FLASHCERT_SHARE_DATABASE_URL=postgresql+psycopg://flashcert:a-long-random-password@db/flashcert

# FLASHCERT_SHARE_SITE_NAME=FlashCert
# FLASHCERT_SHARE_MAX_UPLOAD_MB=20
# FLASHCERT_SHARE_REPORTS_PER_HOUR=20

# Recovery and confirmation thresholds (0.3+).
# FLASHCERT_SHARE_HISTORY_LIMIT=20
# FLASHCERT_SHARE_TRASH_DAYS=30
# FLASHCERT_SHARE_NOTES_CHANGE_PERCENT=30
# FLASHCERT_SHARE_ITEMS_CHANGE_PERCENT=20

# Sharing with other people (0.5+). What "Add to FlashCert" may offer (copy, follow, join, edit, or none),
# invitations, and joins allowed per visitor IP per hour.
# FLASHCERT_SHARE_LINK_ACTIONS=copy,follow,edit
# FLASHCERT_SHARE_INVITES=1
# FLASHCERT_SHARE_JOINS_PER_HOUR=10
